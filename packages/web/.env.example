# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ===============================
# Shopify Configuration
# ===============================
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# ===============================
# Analytics & Tracking
# ===============================
# Segment Write Key (for analytics)
NEXT_PUBLIC_SEGMENT_WRITE_KEY=your_segment_write_key

# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# ===============================
# Error Tracking
# ===============================
# Sentry DSN for error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx.ingest.sentry.io/xxxxxxx

# ===============================
# Customer Support
# ===============================
# Chatwoot Website Token
NEXT_PUBLIC_CHATWOOT_TOKEN=your_chatwoot_token
NEXT_PUBLIC_CHATWOOT_URL=https://your-chatwoot-instance.com

# ===============================
# Application Settings
# ===============================
# Log level (debug, info, warn, error)
NEXT_PUBLIC_LOG_LEVEL=info

# Default currency (USD, EUR, GBP, etc.)
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Default locale (en, de, fr, es, it)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# ===============================
# Internal API Routes
# ===============================
# API base URLs (for server-side requests)
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_api_token
SHOPIFY_API_VERSION=2024-10

# ===============================
# Deployment Environment
# ===============================
NODE_ENV=production
