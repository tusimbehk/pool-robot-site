# ============================================
# 生产环境变量配置
# 部署到 Vercel 时使用此配置
# ============================================

# ============================================
# 数据库配置
# ============================================
# 从 Supabase / Neon / Railway 等获取
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# Shopify 配置
# ============================================
# Shopify 店铺名称 (格式: your-shop.myshopify.com)
SHOPIFY_SHOP_NAME=your-shop.myshopify.com

# Shopify Admin API Access Token
# 获取位置: Shopify Admin → Settings → Apps and sales channels → Develop apps
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxx

# Shopify Webhook Secret (用于验证 webhook 请求)
# 获取位置: Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# 营销自动化 - Resend 邮件
# ============================================
# Resend API Key
# 获取位置: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx

# 发件邮箱地址
# 注意: 需要在 Resend 中验证此域名或使用 Resend 提供的测试邮箱
FROM_EMAIL=noreply@poolclean.com

# Cron 任务安全密钥 (用于保护定时任务端点)
# 已生成，无需修改
CRON_SECRET=63f94f887501164895b9ba4dd26ac1191a6473fb2c35daa9f32ae0e07592ddc5

# ============================================
# 管理后台配置
# ============================================
# 管理后台登录密码
# 登录地址: /admin/login
ADMIN_PASSWORD=admin123

# ============================================
# 可选配置
# ============================================
# Sentry 错误追踪 (可选)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxx.ingest.sentry.io/xxxxxxx
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxx

# 下一个应用 URL (用于 OAuth 回调等)
# NEXT_PUBLIC_APP_URL=https://your-domain.com
